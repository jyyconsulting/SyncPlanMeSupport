{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SyncPlan.Me Help",
  "colors": {
    "primary": "#1366b9",
    "light": "#5E98E6",
    "dark": "#0F5294"
  },
  "favicon": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg"
  },
  "navigation": {
    "pages": [
      "about",
      "getting-started",
      {
        "group": "FAQ",
